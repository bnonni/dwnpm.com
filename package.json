{
  "name": "@dwnp/root",
  "version": "5.1.0",
  "type": "module",
  "description": "Decentralized Web Node Package Manager (DWNPM) helps developers publish, install, find and manage Decentralized Packages (DPKs) published to Decentralized Web Nodes (DWNs) acting as a personal or public Decentralized Web Node Package Registry (DWNPR). DWNPM does this by looking up a Decentralized Identifier (DID) to find its DID document and parse out the DWN service endpoint. The endpoint points to the location of the DID owner's DWN, which acts as a DWNPR, and DWNPM queries the endpoint for any DPKs with matching metadata locally installing the corresponding package release (source code). Both the DPK metadata and DPK release are stored in the DWNPR as binary blobs. Metadata mime-type is application/json and release mime-type is application/gzip.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "dwnpm": "./dist/cli/dwnpm.js",
    "dwnpr": "./dist/cli/dwnpr.js",
    "create-dpk": "./dist/cli/create-dpk.js",
    "init-dpk": "./dist/cli/init-dpk.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "homepage": "https://dwnpm.com",
  "bugs": {
    "url": "https://github.com/bnonni/dwnpm.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bnonni/dwnpm.com.git"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Bryan Nonni",
      "url": "https://github.com/bnonni"
    },
    {
      "name": "Daniel Buchner",
      "url": "https://github.com/csuwildcat"
    },
    {
      "name": "Zach M",
      "url": "https://github.com/phuncti0n"
    },
    {
      "name": "w3irdrobot",
      "url": "https://github.com/w3irdrobot"
    }
  ],
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "decentralized web node package manager",
    "decentralized package manager",
    "decentralized package registry",
    "package registry",
    "package manager",
    "decentralized",
    "decentralized applications",
    "decentralized identity",
    "decentralized web",
    "dweb node",
    "decentralized web node",
    "dwn protocol",
    "decentralized identifiers",
    "decentralized module imports",
    "decentralized package imports",
    "decentralized package",
    "decentralized packages",
    "decentralized resource locator",
    "decentralized resource locators",
    "decentralized identity foundation",
    "dif",
    "web5",
    "dpm",
    "dpr",
    "dwn",
    "dwnpm",
    "dids",
    "dpks",
    "drls",
    "drl"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node ./dist/registry/server.js",
    "prepack": "npm run build && chmod +x ./dist/cli/dwnpm.js ./dist/cli/create-dpk.js ./dist/cli/init-dpk.js",
    "clean": "rimraf dist coverage tests/compiled",
    "wipe": "rimraf node_modules pnpm-lock.json DATA",
    "create": "npm create dpk",
    "init-dpk": "npx init-dpk",
    "tab:1": "[[ -f ~/.npmrc ]] && cp ~/.npmrc ~/.npmrc.dwnpm.bak || cp .npmrc ~/.npmrc",
    "tab:2": "sh build/docker.sh",
    "tab:3": "./dist/cli/dwnpm.js profile create -e http://localhost:3000",
    "tab:4": "./dist/cli/dwnpm.js protocol configure",
    "tab:5": "node ./dist/registry/server.js",
    "tab:6": "./dist/cli/dwnpm.js profile get -d",
    "test:register-hooks": "echo 'Unimplemented!' && exit 0 && npm run build:tests; node --import ./dist/src/register.js ./tests/compiled/tests/register-hooks.spec.js",
    "build": "npm run build:esm && npm run build:cjs",
    "build:cjs": "rimraf dist/cjs && tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > ./dist/cjs/package.json",
    "build:esm": "rimraf dist dist/types && tsc -p tsconfig.json && chmod +x ./dist/cli/dwnpm.js",
    "build:tests": "rimraf tests/compiled && tsc -p tests/tsconfig.json",
    "install:cli": "rm -f $HOME/.config/dwnpm/bin/dwnpm && npm run build && ln -s $(pwd)/dist/cli/dwnpm.js $HOME/.config/dwnpm/bin/dwnpm",
    "version:cli": "sh scripts/cli/version.sh",
    "registry:start": "sh scripts/registryd/start-restart.sh",
    "registry:stop": "sh scripts/registryd/stop.sh",
    "registry:restart": "npm run registry:start -- -f",
    "registry:info": "sh scripts/registryd/info.sh",
    "docker:push": "docker push registry.digitalocean.com/nonni/dwnpm-registry",
    "docker:build": "docker build -f build/Dockerfile.registry -t registry.digitalocean.com/nonni/dwnpm-registry .",
    "docker:run": "docker run -d --rm --network dwnpm-network -p 2092:2092 --name dwnpm-registry registry.digitalocean.com/nonni/dwnpm-registry"
  },
  "dependencies": {
    "@bugsnag/cuid": "^3.1.1",
    "@inquirer/prompts": "^7.0.1",
    "@scure/bip39": "^1.5.4",
    "@tbd54566975/dwn-sdk-js": "^0.5.1",
    "@web5/agent": "^0.8.1",
    "@web5/api": "^0.12.0",
    "@web5/common": "^1.1.0",
    "@web5/credentials": "^1.1.3",
    "@web5/crypto": "^1.0.6",
    "@web5/dids": "^1.2.0",
    "@web5/user-agent": "^0.7.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "did-btc-sdk": "^1.0.0",
    "express": "^4.21.0",
    "fs-extra": "^11.2.0",
    "tar": "^7.4.3",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/chai": "^5.0.1",
    "@types/chai-as-promised": "^8.0.1",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.5.4",
    "@types/npm": "^7.19.3",
    "@types/tar-stream": "^3.1.3",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "c8": "^10.1.2",
    "chai": "^5.1.2",
    "chai-as-promised": "^8.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "eslint-plugin-mocha": "^10.5.0",
    "globals": "^15.11.0",
    "marked": "^14.1.2",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "node-stdlib-browser": "^1.2.1",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0"
  }
}
